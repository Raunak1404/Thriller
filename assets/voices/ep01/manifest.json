{
  "A1-02-0": {
    "file": "A1-02-0.flac",
    "duration": 5.115,
    "who": "ELIAS",
    "text": "Everything that was ever made remembers being made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "469094db3d6b",
    "qa": "ok"
  },
  "A1-02-1": {
    "file": "A1-02-1.flac",
    "duration": 2.921,
    "who": "ELIAS",
    "text": "A chair remembers the carpenter.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "75367c0feb44",
    "qa": "ok"
  },
  "A1-02-2": {
    "file": "A1-02-2.flac",
    "duration": 3.119,
    "who": "ELIAS",
    "text": "A ring remembers the furnace.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "3802aed62843",
    "qa": "ok"
  },
  "A1-02-3": {
    "file": "A1-02-3.flac",
    "duration": 4.761,
    "who": "ELIAS",
    "text": "A letter remembers the hand that shook while it was written.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "642d2fb8c43e",
    "qa": "ok"
  },
  "A1-03-0": {
    "file": "A1-03-0.flac",
    "duration": 6.541,
    "who": "ELIAS",
    "text": "When I touch them, I'm there. The exact moment they were made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "76671c763983",
    "qa": "ok"
  },
  "A1-03-1": {
    "file": "A1-03-1.flac",
    "duration": 3.354,
    "who": "ELIAS",
    "text": "Watching. Invisible.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "79b89bcfdba5",
    "qa": "ok"
  },
  "A1-03-2": {
    "file": "A1-03-2.flac",
    "duration": 1.829,
    "who": "ELIAS",
    "text": "So I don't touch much.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "c598628515ee",
    "qa": "ok"
  },
  "A1-04-0": {
    "file": "A1-04-0.flac",
    "duration": 2.94,
    "who": "ELIAS",
    "text": "I have rules.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "f25bdc5f2f90",
    "qa": "ok"
  },
  "A1-04-1": {
    "file": "A1-04-1.flac",
    "duration": 3.548,
    "who": "ELIAS",
    "text": "One. Wear the gloves.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "abf4112d3089",
    "qa": "ok"
  },
  "A1-04-2": {
    "file": "A1-04-2.flac",
    "duration": 4.334,
    "who": "ELIAS",
    "text": "Two. Never stay longer than three minutes.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "ef8b27e13452",
    "qa": "ok"
  },
  "A1-04-3": {
    "file": "A1-04-3.flac",
    "duration": 5.813,
    "who": "ELIAS",
    "text": "Three. Never touch anything that's still warm.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "f6efd514fe9a",
    "qa": "ok"
  },
  "A1-04-4": {
    "file": "A1-04-4.flac",
    "duration": 1.293,
    "who": "ELIAS",
    "text": "Four.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "67ad2c38e664",
    "qa": "ok"
  },
  "A1-04-5": {
    "file": "A1-04-5.flac",
    "duration": 2.671,
    "who": "ELIAS",
    "text": "Don't open the letter.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "23a20e41d75d",
    "qa": "ok"
  },
  "A1-05-0": {
    "file": "A1-05-0.flac",
    "duration": 3.809,
    "who": "RECEPTIONIST",
    "text": "Mr. Thorne, it's Dr. Hale's office again.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "70e9901a7b70",
    "qa": "ok"
  },
  "A1-05-1": {
    "file": "A1-05-1.flac",
    "duration": 7.463,
    "who": "RECEPTIONIST",
    "text": "It's about your scans. The lesions are... progressing.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "0312b0884c66",
    "qa": "ok"
  },
  "A1-05-2": {
    "file": "A1-05-2.flac",
    "duration": 4.213,
    "who": "RECEPTIONIST",
    "text": "We really need to talk about how much time—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "d82be2f7b705",
    "qa": "ok"
  },
  "A1-07-0": {
    "file": "A1-07-0.flac",
    "duration": 9.614,
    "who": "PEMBERTON",
    "text": "Mr. Thorne? They said you're the man who... finds things out. About old things.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "a2db77e1b938",
    "qa": "ok"
  },
  "A1-07-1": {
    "file": "A1-07-1.flac",
    "duration": 3.874,
    "who": "ELIAS",
    "text": "I do provenance, Mrs....?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "b35608655927",
    "qa": "ok"
  },
  "A1-07-2": {
    "file": "A1-07-2.flac",
    "duration": 3.253,
    "who": "PEMBERTON",
    "text": "Pemberton. Odile.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "32c2cdae69f3",
    "qa": "ok"
  },
  "A1-08-0": {
    "file": "A1-08-0.flac",
    "duration": 4.881,
    "who": "PEMBERTON",
    "text": "It was Henry's. It stopped the night he died.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "2be9d85e62ed",
    "qa": "ok"
  },
  "A1-08-1": {
    "file": "A1-08-1.flac",
    "duration": 2.707,
    "who": "PEMBERTON",
    "text": "I don't need it fixed.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "177baf9623c0",
    "qa": "ok"
  },
  "A1-08-2": {
    "file": "A1-08-2.flac",
    "duration": 5.123,
    "who": "PEMBERTON",
    "text": "I just want to know if he was happy. When he bought it.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "4479f78b545d",
    "qa": "ok"
  },
  "A1-08-3": {
    "file": "A1-08-3.flac",
    "duration": 1.632,
    "who": "PEMBERTON",
    "text": "He never told me.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "a09fd1eec54c",
    "qa": "ok"
  },
  "A1-09-0": {
    "file": "A1-09-0.flac",
    "duration": 3.285,
    "who": "ELIAS",
    "text": "...Three minutes.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "33fa4504ae6b",
    "qa": "ok"
  },
  "A1-11-0": {
    "file": "A1-11-0.flac",
    "duration": 6.912,
    "who": "ABERNATHY",
    "text": "Engraving's done. 'For Odile, every second, yours.'",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "ed5cd3284a34",
    "qa": "ok"
  },
  "A1-11-1": {
    "file": "A1-11-1.flac",
    "duration": 1.985,
    "who": "ABERNATHY",
    "text": "Bit much, isn't it?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "92fc525db08c",
    "qa": "ok"
  },
  "A1-11-2": {
    "file": "A1-11-2.flac",
    "duration": 2.538,
    "who": "HENRY",
    "text": "It's not enough.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "ed213bd0b4d0",
    "qa": "ok"
  },
  "A1-11-3": {
    "file": "A1-11-3.flac",
    "duration": 2.662,
    "who": "HENRY",
    "text": "I'm asking her tonight.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "c06cab6d4447",
    "qa": "ok"
  },
  "A1-11-4": {
    "file": "A1-11-4.flac",
    "duration": 3.454,
    "who": "HENRY",
    "text": "I'm terrified, Mr. Abernathy.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "1bc2a153f376",
    "qa": "ok"
  },
  "A1-11-5": {
    "file": "A1-11-5.flac",
    "duration": 3.137,
    "who": "ABERNATHY",
    "text": "Good. Means it matters.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "a808eb570ea8",
    "qa": "ok"
  },
  "A1-12-0": {
    "file": "A1-12-0.flac",
    "duration": 1.403,
    "who": "HENRY",
    "text": "Every second.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "d5c6b8ef7487",
    "qa": "ok"
  },
  "A1-12-1": {
    "file": "A1-12-1.flac",
    "duration": 2.271,
    "who": "HENRY",
    "text": "Every single one.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "6f5ce6cb8258",
    "qa": "ok"
  },
  "A1-14-0": {
    "file": "A1-14-0.flac",
    "duration": 3.21,
    "who": "PEMBERTON",
    "text": "Mr. Thorne, you're bleeding—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "d007b0a268e1",
    "qa": "ok"
  },
  "A1-14-1": {
    "file": "A1-14-1.flac",
    "duration": 2.254,
    "who": "ELIAS",
    "text": "It's nothing. It's—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "7cd132c02445",
    "qa": "ok"
  },
  "A1-14-2": {
    "file": "A1-14-2.flac",
    "duration": 2.627,
    "who": "ELIAS",
    "text": "He was terrified.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "7af788750362",
    "qa": "ok"
  },
  "A1-14-3": {
    "file": "A1-14-3.flac",
    "duration": 3.963,
    "who": "ELIAS",
    "text": "And he was the happiest man I've ever seen.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "f748cb4f411a",
    "qa": "ok"
  },
  "A1-14-4": {
    "file": "A1-14-4.flac",
    "duration": 1.888,
    "who": "PEMBERTON",
    "text": "Every second...",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "3f3cbdbf0d04",
    "qa": "ok"
  },
  "A1-14-5": {
    "file": "A1-14-5.flac",
    "duration": 1.609,
    "who": "PEMBERTON",
    "text": "He used to say that.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "0b4d5966509d",
    "qa": "ok"
  },
  "A1-15-0": {
    "file": "A1-15-0.flac",
    "duration": 2.661,
    "who": "ELIAS",
    "text": "Everything remembers being made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "72bb1b50e8ed",
    "qa": "ok"
  },
  "A1-15-1": {
    "file": "A1-15-1.flac",
    "duration": 5.53,
    "who": "ELIAS",
    "text": "I've just never wanted to know how anything ends.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "7983fbb039bc",
    "qa": "ok"
  },
  "A2-05-0": {
    "file": "A2-05-0.flac",
    "duration": 4.255,
    "who": "CHILD",
    "text": "Mum... why is the sky bleeding?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Leda",
    "hash": "92a2ef416256",
    "qa": "ok"
  },
  "A2-09-0": {
    "file": "A2-09-0.flac",
    "duration": 8.922,
    "who": "ANCHOR",
    "text": "...a phenomenon meteorologists are calling an 'atmospheric glitch', reported across the entire northern hemisphere at three-twelve this afternoon.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Rasalgethi",
    "hash": "1fc0d2c6250c",
    "qa": "ok"
  },
  "A2-10-0": {
    "file": "A2-10-0.flac",
    "duration": 6.571,
    "who": "MARLOWE",
    "text": "Our instruments registered a gravitational anomaly lasting exactly nine seconds.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "6556ed554a20",
    "qa": "ok"
  },
  "A2-10-1": {
    "file": "A2-10-1.flac",
    "duration": 5.982,
    "who": "MARLOWE",
    "text": "Gravity didn't fail. It... doubled.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "dfcb13fcdd0f",
    "qa": "ok"
  },
  "A2-10-2": {
    "file": "A2-10-2.flac",
    "duration": 5.01,
    "who": "MARLOWE",
    "text": "As though the atmosphere was rejecting something.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "3461243be95a",
    "qa": "ok"
  },
  "A2-11-0": {
    "file": "A2-11-0.flac",
    "duration": 3.896,
    "who": "ANCHOR",
    "text": "Officials insist there is no cause for alarm.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Rasalgethi",
    "hash": "82f8463c2503",
    "qa": "ok"
  },
  "A2-12-0": {
    "file": "A2-12-0.flac",
    "duration": 2.467,
    "who": "ELIAS",
    "text": "Nine seconds.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "4c743e3b404d",
    "qa": "ok"
  },
  "A2-12-1": {
    "file": "A2-12-1.flac",
    "duration": 2.48,
    "who": "ELIAS",
    "text": "I told myself it was nothing.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "562043d7c655",
    "qa": "ok"
  },
  "A2-12-2": {
    "file": "A2-12-2.flac",
    "duration": 3.29,
    "who": "ELIAS",
    "text": "I'm very good at that.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "1090e072a7a5",
    "qa": "ok"
  },
  "A3-04-0": {
    "file": "A3-04-0.flac",
    "duration": 2.979,
    "who": "SEREN",
    "text": "Elias Thorne.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "45d39b401baf",
    "qa": "ok"
  },
  "A3-04-1": {
    "file": "A3-04-1.flac",
    "duration": 2.406,
    "who": "SEREN",
    "text": "The man who touches things.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "de113a4c2aa5",
    "qa": "ok"
  },
  "A3-04-2": {
    "file": "A3-04-2.flac",
    "duration": 4.36,
    "who": "ELIAS",
    "text": "We're— we're closed. There's a hospital two streets—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "4d14bdd1335a",
    "qa": "ok"
  },
  "A3-04-3": {
    "file": "A3-04-3.flac",
    "duration": 2.603,
    "who": "SEREN",
    "text": "Hospitals can't fix what's wrong with me.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "c6a33b2bab83",
    "qa": "ok"
  },
  "A3-04-4": {
    "file": "A3-04-4.flac",
    "duration": 1.365,
    "who": "SEREN",
    "text": "Or with you.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "6aa5487a83ff",
    "qa": "ok"
  },
  "A3-05-0": {
    "file": "A3-05-0.flac",
    "duration": 3.145,
    "who": "ELIAS",
    "text": "Where did you get that?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "7d44dbf79cd2",
    "qa": "ok"
  },
  "A3-05-1": {
    "file": "A3-05-1.flac",
    "duration": 2.618,
    "who": "SEREN",
    "text": "From a world that died yesterday.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "c9036cdf36a1",
    "qa": "ok"
  },
  "A3-06-0": {
    "file": "A3-06-0.flac",
    "duration": 4.816,
    "who": "ELIAS",
    "text": "No. No, whatever this is, I catalogue things. I date furniture. I'm not—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "1575890a1ef8",
    "qa": "ok"
  },
  "A3-06-1": {
    "file": "A3-06-1.flac",
    "duration": 4.009,
    "who": "SEREN",
    "text": "Brave? I know.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "c093390fb674",
    "qa": "ok"
  },
  "A3-06-2": {
    "file": "A3-06-2.flac",
    "duration": 2.32,
    "who": "SEREN",
    "text": "I'm not asking you to be brave.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "2e845c0b00d8",
    "qa": "ok"
  },
  "A3-06-3": {
    "file": "A3-06-3.flac",
    "duration": 2.78,
    "who": "SEREN",
    "text": "I'm asking you to touch it.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "60196659f438",
    "qa": "ok"
  },
  "A3-07-0": {
    "file": "A3-07-0.flac",
    "duration": 2.362,
    "who": "ELIAS",
    "text": "What is THAT?!",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "aa0b4c7fdb05",
    "qa": "ok"
  },
  "A3-07-1": {
    "file": "A3-07-1.flac",
    "duration": 2.757,
    "who": "SEREN",
    "text": "A Fray. Leftovers.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "0774defcd7a4",
    "qa": "ok"
  },
  "A3-07-2": {
    "file": "A3-07-2.flac",
    "duration": 6.428,
    "who": "SEREN",
    "text": "When two worlds touch, things get... mixed.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "1b778021867a",
    "qa": "ok"
  },
  "A3-09-0": {
    "file": "A3-09-0.flac",
    "duration": 3.175,
    "who": "SEREN",
    "text": "They're coming through faster.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "545877507858",
    "qa": "ok"
  },
  "A3-09-1": {
    "file": "A3-09-1.flac",
    "duration": 1.139,
    "who": "SEREN",
    "text": "Please.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "cd5897997b05",
    "qa": "ok"
  },
