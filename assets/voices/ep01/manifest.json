{
  "A1-02-0": {
    "file": "A1-02-0.flac",
    "duration": 5.115,
    "who": "ELIAS",
    "text": "Everything that was ever made remembers being made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "d5d732529067",
    "qa": "ok"
  },
  "A1-02-1": {
    "file": "A1-02-1.flac",
    "duration": 2.921,
    "who": "ELIAS",
    "text": "A chair remembers the carpenter.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "4d141a453600",
    "qa": "ok"
  },
  "A1-02-2": {
    "file": "A1-02-2.flac",
    "duration": 3.119,
    "who": "ELIAS",
    "text": "A ring remembers the furnace.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "daa5271c1427",
    "qa": "ok"
  },
  "A1-02-3": {
    "file": "A1-02-3.flac",
    "duration": 4.761,
    "who": "ELIAS",
    "text": "A letter remembers the hand that shook while it was written.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "42f093525e2d",
    "qa": "ok"
  },
  "A1-03-0": {
    "file": "A1-03-0.flac",
    "duration": 6.541,
    "who": "ELIAS",
    "text": "When I touch them, I'm there. The exact moment they were made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "6054d42976bf",
    "qa": "ok"
  },
  "A1-03-1": {
    "file": "A1-03-1.flac",
    "duration": 3.354,
    "who": "ELIAS",
    "text": "Watching. Invisible.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "77bef2556844",
    "qa": "ok"
  },
  "A1-03-2": {
    "file": "A1-03-2.flac",
    "duration": 1.829,
    "who": "ELIAS",
    "text": "So I don't touch much.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "512faf3c4ae0",
    "qa": "ok"
  },
  "A1-04-0": {
    "file": "A1-04-0.flac",
    "duration": 2.94,
    "who": "ELIAS",
    "text": "I have rules.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "b651e051c38e",
    "qa": "ok"
  },
  "A1-04-1": {
    "file": "A1-04-1.flac",
    "duration": 3.548,
    "who": "ELIAS",
    "text": "One. Wear the gloves.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "252112b2d55a",
    "qa": "ok"
  },
  "A1-04-2": {
    "file": "A1-04-2.flac",
    "duration": 4.334,
    "who": "ELIAS",
    "text": "Two. Never stay longer than three minutes.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "a8c6dad8c537",
    "qa": "ok"
  },
  "A1-04-3": {
    "file": "A1-04-3.flac",
    "duration": 5.813,
    "who": "ELIAS",
    "text": "Three. Never touch anything that's still warm.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "8612b7992268",
    "qa": "ok"
  },
  "A1-04-4": {
    "file": "A1-04-4.flac",
    "duration": 1.293,
    "who": "ELIAS",
    "text": "Four.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "3ddd3102056d",
    "qa": "ok"
  },
  "A1-04-5": {
    "file": "A1-04-5.flac",
    "duration": 2.671,
    "who": "ELIAS",
    "text": "Don't open the letter.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "72ff507ed428",
    "qa": "ok"
  },
  "A1-05-0": {
    "file": "A1-05-0.flac",
    "duration": 3.169,
    "who": "RECEPTIONIST",
    "text": "Mr. Thorne, it's Dr. Hale's office again.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "cffd696c2a41",
    "qa": "ok"
  },
  "A1-05-1": {
    "file": "A1-05-1.flac",
    "duration": 7.993,
    "who": "RECEPTIONIST",
    "text": "It's about your scans. The lesions are... progressing.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "31518851795b",
    "qa": "ok"
  },
  "A1-05-2": {
    "file": "A1-05-2.flac",
    "duration": 4.11,
    "who": "RECEPTIONIST",
    "text": "We really need to talk about how much time—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Despina",
    "hash": "8eb5dd9f9b70",
    "qa": "ok"
  },
  "A1-07-0": {
    "file": "A1-07-0.flac",
    "duration": 9.614,
    "who": "PEMBERTON",
    "text": "Mr. Thorne? They said you're the man who... finds things out. About old things.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "b247a994da79",
    "qa": "ok"
  },
  "A1-07-1": {
    "file": "A1-07-1.flac",
    "duration": 3.874,
    "who": "ELIAS",
    "text": "I do provenance, Mrs....?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "04c73a183b4a",
    "qa": "ok"
  },
  "A1-07-2": {
    "file": "A1-07-2.flac",
    "duration": 3.253,
    "who": "PEMBERTON",
    "text": "Pemberton. Odile.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "00be2646991c",
    "qa": "ok"
  },
  "A1-08-0": {
    "file": "A1-08-0.flac",
    "duration": 4.881,
    "who": "PEMBERTON",
    "text": "It was Henry's. It stopped the night he died.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "03769bf340d3",
    "qa": "ok"
  },
  "A1-08-1": {
    "file": "A1-08-1.flac",
    "duration": 2.707,
    "who": "PEMBERTON",
    "text": "I don't need it fixed.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "248992ae3f0f",
    "qa": "ok"
  },
  "A1-08-2": {
    "file": "A1-08-2.flac",
    "duration": 5.123,
    "who": "PEMBERTON",
    "text": "I just want to know if he was happy. When he bought it.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "c2a6fcbd4782",
    "qa": "ok"
  },
  "A1-08-3": {
    "file": "A1-08-3.flac",
    "duration": 1.632,
    "who": "PEMBERTON",
    "text": "He never told me.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "4d60cfd89e4d",
    "qa": "ok"
  },
  "A1-09-0": {
    "file": "A1-09-0.flac",
    "duration": 3.285,
    "who": "ELIAS",
    "text": "...Three minutes.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "25f2a5c4698a",
    "qa": "ok"
  },
  "A1-11-0": {
    "file": "A1-11-0.flac",
    "duration": 8.142,
    "who": "ABERNATHY",
    "text": "Engraving's done. 'For Odile, every second, yours.'",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "efc4b7c2a58a",
    "qa": "ok"
  },
  "A1-11-1": {
    "file": "A1-11-1.flac",
    "duration": 2.322,
    "who": "ABERNATHY",
    "text": "Bit much, isn't it?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "9086993bf90c",
    "qa": "ok"
  },
  "A1-11-2": {
    "file": "A1-11-2.flac",
    "duration": 2.502,
    "who": "HENRY",
    "text": "It's not enough.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "68243d948c13",
    "qa": "ok"
  },
  "A1-11-3": {
    "file": "A1-11-3.flac",
    "duration": 1.926,
    "who": "HENRY",
    "text": "I'm asking her tonight.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "a5d0c1783be4",
    "qa": "ok"
  },
  "A1-11-4": {
    "file": "A1-11-4.flac",
    "duration": 4.414,
    "who": "HENRY",
    "text": "I'm terrified, Mr. Abernathy.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "408a4d3c8c8e",
    "qa": "ok"
  },
  "A1-11-5": {
    "file": "A1-11-5.flac",
    "duration": 2.837,
    "who": "ABERNATHY",
    "text": "Good. Means it matters.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Orus",
    "hash": "f39119e2898b",
    "qa": "ok"
  },
  "A1-12-0": {
    "file": "A1-12-0.flac",
    "duration": 1.977,
    "who": "HENRY",
    "text": "Every second.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "c2fd525ccacd",
    "qa": "ok"
  },
  "A1-12-1": {
    "file": "A1-12-1.flac",
    "duration": 2.549,
    "who": "HENRY",
    "text": "Every single one.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Puck",
    "hash": "71df4708316a",
    "qa": "ok"
  },
  "A1-14-0": {
    "file": "A1-14-0.flac",
    "duration": 3.21,
    "who": "PEMBERTON",
    "text": "Mr. Thorne, you're bleeding—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "299cb09f3900",
    "qa": "ok"
  },
  "A1-14-1": {
    "file": "A1-14-1.flac",
    "duration": 2.254,
    "who": "ELIAS",
    "text": "It's nothing. It's—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "85852f73db7c",
    "qa": "ok"
  },
  "A1-14-2": {
    "file": "A1-14-2.flac",
    "duration": 2.627,
    "who": "ELIAS",
    "text": "He was terrified.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "58efbfc8e105",
    "qa": "ok"
  },
  "A1-14-3": {
    "file": "A1-14-3.flac",
    "duration": 3.963,
    "who": "ELIAS",
    "text": "And he was the happiest man I've ever seen.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "bc64a73310cc",
    "qa": "ok"
  },
  "A1-14-4": {
    "file": "A1-14-4.flac",
    "duration": 1.888,
    "who": "PEMBERTON",
    "text": "Every second...",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "d3c89b5566c4",
    "qa": "ok"
  },
  "A1-14-5": {
    "file": "A1-14-5.flac",
    "duration": 1.609,
    "who": "PEMBERTON",
    "text": "He used to say that.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Gacrux",
    "hash": "cb163d9617ee",
    "qa": "ok"
  },
  "A1-15-0": {
    "file": "A1-15-0.flac",
    "duration": 2.661,
    "who": "ELIAS",
    "text": "Everything remembers being made.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "27e9a7549d90",
    "qa": "ok"
  },
  "A1-15-1": {
    "file": "A1-15-1.flac",
    "duration": 5.53,
    "who": "ELIAS",
    "text": "I've just never wanted to know how anything ends.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "bf2ad7a3438e",
    "qa": "ok"
  },
  "A2-05-0": {
    "file": "A2-05-0.flac",
    "duration": 4.255,
    "who": "CHILD",
    "text": "Mum... why is the sky bleeding?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Leda",
    "hash": "374a5299dcd5",
    "qa": "ok"
  },
  "A2-09-0": {
    "file": "A2-09-0.flac",
    "duration": 8.967,
    "who": "ANCHOR",
    "text": "...a phenomenon meteorologists are calling an 'atmospheric glitch', reported across the entire northern hemisphere at three-twelve this afternoon.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Rasalgethi",
    "hash": "8b5824911430",
    "qa": "ok"
  },
  "A2-10-0": {
    "file": "A2-10-0.flac",
    "duration": 6.515,
    "who": "MARLOWE",
    "text": "Our instruments registered a gravitational anomaly lasting exactly nine seconds.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "ad4c7015e764",
    "qa": "ok"
  },
  "A2-10-1": {
    "file": "A2-10-1.flac",
    "duration": 7.284,
    "who": "MARLOWE",
    "text": "Gravity didn't fail. It... doubled.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "6a4b6fb556a9",
    "qa": "ok"
  },
  "A2-10-2": {
    "file": "A2-10-2.flac",
    "duration": 5.667,
    "who": "MARLOWE",
    "text": "As though the atmosphere was rejecting something.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Sadaltager",
    "hash": "ef9c438686dd",
    "qa": "ok"
  },
  "A2-11-0": {
    "file": "A2-11-0.flac",
    "duration": 3.855,
    "who": "ANCHOR",
    "text": "Officials insist there is no cause for alarm.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Rasalgethi",
    "hash": "69ed94e8fde8",
    "qa": "ok"
  },
  "A2-12-0": {
    "file": "A2-12-0.flac",
    "duration": 2.467,
    "who": "ELIAS",
    "text": "Nine seconds.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "c12e729fc583",
    "qa": "ok"
  },
  "A2-12-1": {
    "file": "A2-12-1.flac",
    "duration": 2.48,
    "who": "ELIAS",
    "text": "I told myself it was nothing.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "321188ba6690",
    "qa": "ok"
  },
  "A2-12-2": {
    "file": "A2-12-2.flac",
    "duration": 3.29,
    "who": "ELIAS",
    "text": "I'm very good at that.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "9026690e4705",
    "qa": "ok"
  },
  "A3-04-0": {
    "file": "A3-04-0.flac",
    "duration": 2.979,
    "who": "SEREN",
    "text": "Elias Thorne.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "f38e07b7143c",
    "qa": "ok"
  },
  "A3-04-1": {
    "file": "A3-04-1.flac",
    "duration": 2.406,
    "who": "SEREN",
    "text": "The man who touches things.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "fa77a0163940",
    "qa": "ok"
  },
  "A3-04-2": {
    "file": "A3-04-2.flac",
    "duration": 4.36,
    "who": "ELIAS",
    "text": "We're— we're closed. There's a hospital two streets—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "205d0688d0ba",
    "qa": "ok"
  },
  "A3-04-3": {
    "file": "A3-04-3.flac",
    "duration": 2.603,
    "who": "SEREN",
    "text": "Hospitals can't fix what's wrong with me.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "1602b81273d7",
    "qa": "ok"
  },
  "A3-04-4": {
    "file": "A3-04-4.flac",
    "duration": 1.365,
    "who": "SEREN",
    "text": "Or with you.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "71fb7dc3bfe5",
    "qa": "ok"
  },
  "A3-05-0": {
    "file": "A3-05-0.flac",
    "duration": 3.145,
    "who": "ELIAS",
    "text": "Where did you get that?",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "9cdf6998b24e",
    "qa": "ok"
  },
  "A3-05-1": {
    "file": "A3-05-1.flac",
    "duration": 2.618,
    "who": "SEREN",
    "text": "From a world that died yesterday.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "15c309c12ad8",
    "qa": "ok"
  },
  "A3-06-0": {
    "file": "A3-06-0.flac",
    "duration": 4.816,
    "who": "ELIAS",
    "text": "No. No, whatever this is, I catalogue things. I date furniture. I'm not—",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "bdcfc89cef3d",
    "qa": "ok"
  },
  "A3-06-1": {
    "file": "A3-06-1.flac",
    "duration": 4.009,
    "who": "SEREN",
    "text": "Brave? I know.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "3cb261407c42",
    "qa": "ok"
  },
  "A3-06-2": {
    "file": "A3-06-2.flac",
    "duration": 2.32,
    "who": "SEREN",
    "text": "I'm not asking you to be brave.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "2a5e9290f922",
    "qa": "ok"
  },
  "A3-06-3": {
    "file": "A3-06-3.flac",
    "duration": 2.78,
    "who": "SEREN",
    "text": "I'm asking you to touch it.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "a32837aacb2c",
    "qa": "ok"
  },
  "A3-07-0": {
    "file": "A3-07-0.flac",
    "duration": 2.362,
    "who": "ELIAS",
    "text": "What is THAT?!",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Charon",
    "hash": "f8c11e6642f1",
    "qa": "ok"
  },
  "A3-07-1": {
    "file": "A3-07-1.flac",
    "duration": 2.757,
    "who": "SEREN",
    "text": "A Fray. Leftovers.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "5eac7ae5f646",
    "qa": "ok"
  },
  "A3-07-2": {
    "file": "A3-07-2.flac",
    "duration": 6.428,
    "who": "SEREN",
    "text": "When two worlds touch, things get... mixed.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "ad5ca957528a",
    "qa": "ok"
  },
  "A3-09-0": {
    "file": "A3-09-0.flac",
    "duration": 3.175,
    "who": "SEREN",
    "text": "They're coming through faster.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "f91f72144969",
    "qa": "ok"
  },
  "A3-09-1": {
    "file": "A3-09-1.flac",
    "duration": 1.139,
    "who": "SEREN",
    "text": "Please.",
    "model": "gemini-3.1-flash-tts-preview",
    "voice": "Kore",
    "hash": "e7b6c91b6d19",
    "qa": "ok"
  },
